{
  "name": "bandexe-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run prompts && node scripts/dev.js",
    "dev:fixture": "npm run prompts && MARK_FIXTURE=1 node scripts/dev.js",
    "server": "node server/index.js",
    "build": "npm run prompts && tsc --noEmit && vite build",
    "test": "npm run prompts && vitest run",
    "prompts": "node scripts/generate-prompts.js",
    "cf:dev": "npm run build && wrangler pages dev dist",
    "cf:deploy": "npm run build && wrangler pages deploy dist --project-name bandexe"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.85",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.149.0"
  }
}
